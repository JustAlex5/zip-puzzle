# Copy to .env (docker compose / stack deploy can load it)

POSTGRES_PASSWORD=zipgame_dev
POSTGRES_PORT=5432

# Public HTTP port (nginx gateway — UI + API proxy)
HTTP_PORT=80

JWT_SECRET=your-super-secret-key-min-32-characters-long-docker

# Browser Origin when using the gateway (default port 80)
CORS_ORIGINS=http://localhost

# AutoMapper Community license (optional)
# AUTOMAPPER_LICENSE_KEY=

# --- Docker Swarm (docker-stack.yml) ---
# docker swarm init
# .\scripts\build-stack-images.ps1
# $env:DOCKERHUB_USER="local"; docker stack deploy -c docker-stack.yml zip-puzzle
#
# --- Docker Hub (push images) ---
# Create repos: <username>/zip-puzzle-api and <username>/zip-puzzle-gateway
# docker login
# .\scripts\dockerhub-build-push.ps1 -Username "youruser" -Push
# On the server: set DOCKERHUB_USER + TAG same as build, then docker stack deploy
