# Copy to .env and `source` / dotenv before `docker stack deploy`, or export vars in your shell.
#
# ========== Docker Swarm (production) ==========
# docker swarm init
#
# Images (pick one):
#   A) Build locally / in CI — tag must match TAG below:
#        .\scripts\build-stack-images.ps1 -Username <dockerhub_user>
#      (defaults to semver in repo VERSION file)
#   B) Push to Docker Hub, then pull on workers:
#        .\scripts\dockerhub-build-push.ps1 -Username <dockerhub_user> -Push
#
# Deploy / update (PowerShell):
#   $env:DOCKERHUB_USER="<dockerhub_user>"
#   $env:TAG="1.0.1"
#   docker stack deploy -c docker-stack.yml zip-puzzle
#
# Deploy / update (bash):
#   export DOCKERHUB_USER="<dockerhub_user>"
#   export TAG="1.0.1"
#   docker stack deploy -c docker-stack.yml zip-puzzle
#
# Use the same DOCKERHUB_USER + TAG as the images you built/pushed.
# See docker-stack.yml header for full Swarm notes.

POSTGRES_PASSWORD=zipgame_dev
POSTGRES_PORT=5432

# Published gateway port (Swarm ingress)
HTTP_PORT=80

JWT_SECRET=your-super-secret-key-min-32-characters-long-docker

# Browser Origin hitting the gateway (exact scheme + host; no trailing slash).
# With TLS use https://zipgame.duckdns.org — must match what users type in the address bar.
CORS_ORIGINS=http://localhost

# Optional: published Swarm ports (see deploy/docker-stack.gateway-tls.yml for HTTPS)
# HTTP_PORT=80
# HTTPS_PORT=443

# AutoMapper Community license (optional)
# AUTOMAPPER_LICENSE_KEY=

# Explicit stack image tag (must match Hub / local build tag)
# TAG=1.0.1

# --- Docker Hub push only ---
# Repos: <username>/zip-puzzle-api and <username>/zip-puzzle-gateway
# docker login
# .\scripts\dockerhub-build-push.ps1 -Username "youruser" -Push

# ========== Optional: docker-compose (single-machine dev only) ==========
# Not used for Swarm. For local quick start only:
#   docker compose up --build
